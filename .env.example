# Server port (Render injects PORT automatically)
PORT=3000
NODE_ENV=development

# Optional: Set on Render Environment Variables for automatic 24/7 boot even after container restart
DISCORD_TOKEN=""
AUTO_START="false"

# Optional: Auto-join Voice Channel & Stream Image on boot
VOICE_GUILD_ID=""
VOICE_CHANNEL_ID=""
AUTO_JOIN_VOICE="false"
AUTO_STREAM_IMAGE="false"
